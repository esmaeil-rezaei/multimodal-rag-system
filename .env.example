# LLMs
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# HuggingFace — needed for RLHF / fine-tuning model downloads
HF_TOKEN=hf_...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                     # blank for local

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=              # blank for local

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j — only needed when graphrag.enabled: true
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Auth
JWT_SECRET_KEY=                     # 32+ random characters
ENCRYPTION_KEY=                     # optional, field-level encryption

# Observability — configure via operations.observability in config.yaml
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multimodal-rag
ARIZE_SPACE_KEY=
ARIZE_API_KEY=
HELICONE_API_KEY=

# Alerting
SLACK_WEBHOOK_URL=                  # Slack webhook for drift alerts

# App
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
