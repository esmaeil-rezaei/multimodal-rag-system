# ── LLM & Embedding ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                         # leave blank for local/unauthenticated

# ── Sparse Search (Elasticsearch) ────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=                  # leave blank for local/unauthenticated

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Graph DB (Neo4j) — only required when graphrag.enabled: true ──────────────
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=                         # random 32+ character string
ENCRYPTION_KEY=                         # optional: for field-level encryption

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
